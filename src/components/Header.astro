---
import ThemeToggle from './ThemeToggle.astro';
---

<header class="sticky top-0 z-50 border-b border-[color-mix(in_srgb,var(--border)_60%,transparent)] px-6 lg:px-12 py-3.5 flex justify-between items-center transition-colors duration-300" style="background: color-mix(in srgb, var(--bg) 85%, transparent); backdrop-filter: blur(16px) saturate(180%); -webkit-backdrop-filter: blur(16px) saturate(180%);">
  <a href="/" class="flex items-center gap-2.5 no-underline">
    <img src="/icon.png" alt="Tomoro" width="28" height="28" class="rounded-[6px]" />
    <span class="text-[22px] font-extrabold text-[var(--text)] tracking-tight">tomoro</span>
  </a>
  <nav class="flex items-center gap-8">
    <a href="/#features" class="hidden lg:inline text-sm text-[var(--text-secondary)] font-medium no-underline hover:text-[var(--text)] transition-colors">Features</a>
    <a href="/#pricing" class="hidden lg:inline text-sm text-[var(--text-secondary)] font-medium no-underline hover:text-[var(--text)] transition-colors">Pricing</a>
    <a href="/download" class="hidden lg:inline text-sm text-[var(--text-secondary)] font-medium no-underline hover:text-[var(--text)] transition-colors">Download</a>
    <ThemeToggle />
    <a href="https://store.tomoro.me/checkout/buy/afbeabee-10a4-47df-b754-65194e866c89" class="bg-[var(--accent)] text-white px-5 py-2 rounded-[9px] text-[13px] font-semibold no-underline transition-all duration-200 shadow-[0_2px_8px_color-mix(in_srgb,var(--accent)_20%,transparent)] hover:bg-[var(--accent-hover)] hover:shadow-[0_4px_16px_color-mix(in_srgb,var(--accent)_30%,transparent)] hover:-translate-y-px">Buy — $49</a>
  </nav>
</header>
