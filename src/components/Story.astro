      <div>
        <div class="text-[15px] font-semibold tracking-[-0.2px]">Roman Kanevsky</div>
        <div class="text-[13px] text-[var(--text-muted)]">Developer & maker of Tomoro</div>
      </div>
    </div>
  </div>
</section>
