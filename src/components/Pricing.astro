<section id="pricing" class="px-6 lg:px-12 py-[100px] max-w-[960px] mx-auto text-center">
  <div class="text-xs uppercase tracking-[3px] text-[var(--accent)] font-semibold mb-3.5">Pricing</div>
  <h2 class="text-[32px] lg:text-[40px] font-bold tracking-[-1.5px] mb-14 leading-[1.15] text-[var(--text)]">One price. No surprises.</h2>

  <div class="max-w-[440px] mx-auto bg-[var(--white)] border-2 border-[var(--border)] rounded-[20px] p-[40px_32px] lg:p-[52px_44px] text-center relative transition-all duration-300 shadow-[0_8px_40px_rgba(45,42,38,0.04)] hover:border-[color-mix(in_srgb,var(--accent)_30%,transparent)] hover:shadow-[0_16px_60px_rgba(45,42,38,0.06)] dark:hover:shadow-[0_16px_60px_rgba(0,0,0,0.2)]">
    <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-[var(--accent)] text-white text-[11px] font-bold tracking-[1.5px] uppercase px-5 py-1.5 rounded-[20px] shadow-[0_4px_12px_rgba(224,104,48,0.25)]">Early Bird</div>

    <div class="text-[64px] font-extrabold tracking-[-3px] mb-1 text-[var(--text)]">$49</div>
    <div class="text-[15px] text-[var(--text-secondary)] mb-8">One-time purchase. Yours forever.</div>

    <ul class="list-none text-left mb-9 space-y-0">
      {['14-day free trial', 'macOS and Windows', '1 year of updates included', 'Perpetual license — keeps working forever', 'All features unlocked', 'No subscription, no recurring fees'].map(item => (
        <li class="text-[14.5px] text-[var(--text-secondary)] py-2.5 border-b border-[color-mix(in_srgb,var(--border)_60%,transparent)] last:border-b-0 flex items-center gap-3">
          <span class="w-[22px] h-[22px] rounded-full bg-[var(--accent-soft)] flex items-center justify-center shrink-0">
            <svg class="w-3 h-3" viewBox="0 0 12 12" fill="none" stroke="var(--accent)" stroke-width="2.5"><path d="M2.5 6L5 8.5L9.5 3.5"/></svg>
          </span>
          {item}
        </li>
      ))}
    </ul>

    <a href="#" class="block w-full text-center bg-[var(--accent)] text-white px-9 py-4 rounded-xl text-[17px] font-semibold no-underline transition-all duration-300 shadow-[0_4px_16px_rgba(224,104,48,0.25)] hover:bg-[var(--accent-hover)] hover:-translate-y-0.5 hover:shadow-[0_8px_28px_rgba(224,104,48,0.3)]">Buy Tomoro</a>

    <div class="mt-7 p-5 bg-[var(--bg-card)] rounded-xl text-[13px] text-[var(--text-secondary)] leading-relaxed transition-colors">
      Toggl is $9/mo ($108/yr). Harvest is $11/mo ($132/yr).<br>
      Tomoro is <strong class="text-[var(--text)]">$49 once</strong>. You break even in 5 months.
    </div>
  </div>
</section>
