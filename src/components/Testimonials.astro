<section class="px-6 lg:px-12 py-[100px] max-w-[960px] mx-auto">
  <div class="text-xs uppercase tracking-[3px] text-[var(--accent)] font-semibold mb-3.5">What freelancers say</div>
  <h2 class="text-[32px] lg:text-[40px] font-bold tracking-[-1.5px] mb-14 leading-[1.15] text-[var(--text)]">People like you, using Tomoro.</h2>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    {[
      { quote: "I used to track hours in a spreadsheet and forget half of them. Now I just open Tomoro, log my time, and export when it's invoice day. Took me 5 minutes to set up.", name: 'Marcus T.', role: 'Freelance Web Developer', color: '#5b8cd4', initial: 'M' },
      { quote: "Finally something that doesn't try to be Jira. I have three clients, different rates for each. Tomoro just gets out of the way and lets me work.", name: 'Sara K.', role: 'UX Designer', color: '#d4845b', initial: 'S' },
      { quote: "The project folder shortcut is genius — I click straight from my project list into the actual files. And $49 once? I was paying more than that every four months for Harvest.", name: 'James L.', role: 'Audio Engineer & Producer', color: '#7b6bae', initial: 'J' },
    ].map(t => (
      <div class="bg-[var(--white)] rounded-2xl p-[32px_28px] border border-[var(--border)] transition-all duration-300 flex flex-col hover:-translate-y-[3px] hover:shadow-[0_12px_32px_rgba(45,42,38,0.06)] dark:hover:shadow-[0_12px_32px_rgba(0,0,0,0.2)]">
        <div class="text-[#f0a500] text-sm tracking-[2px] mb-4">★★★★★</div>
        <div class="text-[15px] text-[var(--text)] leading-[1.65] flex-1 mb-6">"{t.quote}"</div>
        <div class="flex items-center gap-3 pt-5 border-t border-[var(--border)]">
          <div class="w-10 h-10 rounded-full flex items-center justify-center text-[15px] font-bold text-white shrink-0" style={`background: ${t.color}`}>{t.initial}</div>
          <div>
            <div class="text-sm font-semibold tracking-[-0.2px]">{t.name}</div>
            <div class="text-[12.5px] text-[var(--text-muted)]">{t.role}</div>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
