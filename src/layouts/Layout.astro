---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://tomoro.me/" />

    <!-- Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- OpenGraph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://tomoro.me/" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://tomoro.me/og.png" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://tomoro.me/og.png" />

    <meta name="robots" content="index, follow" />

    <!-- JSON-LD -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "Tomoro",
      "description": "Project tracker for solo freelancers. Organize projects, log hours, set rates, export billing data. Local-first, offline, one-time purchase.",
      "operatingSystem": "macOS, Windows",
      "applicationCategory": "ProductivityApplication",
      "offers": {
        "@type": "Offer",
        "price": "49",
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock"
      },
      "url": "https://tomoro.me",
      "image": "https://tomoro.me/og.png",
      "publisher": {
        "@type": "Organization",
        "name": "Tomoro"
      }
    }
    </script>

    <!-- Dark mode: apply before paint to prevent flash -->
    <script is:inline>
      (function() {
        const stored = localStorage.getItem('tomoro-theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || (!stored && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>

  <body>
    <slot />
  </body>
</html>
