---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Download Tomoro — Project Tracking for Freelancers"
  description="Download Tomoro for macOS or Windows. Free 14-day trial, no account required."
>
  <Header />

  <main class="px-6 lg:px-12 py-[100px] max-w-[700px] mx-auto text-center">
    <div class="text-xs uppercase tracking-[3px] text-[var(--accent)] font-semibold mb-3.5">Download</div>
    <h1 class="text-[32px] lg:text-[40px] font-bold tracking-[-1.5px] mb-3 leading-[1.15] text-[var(--text)]">Get Tomoro</h1>
    <p class="text-[15px] text-[var(--text-secondary)] mb-14">Version 1.0.0 · Free 14-day trial · No account required</p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mb-12">
      <!-- macOS Card -->
      <a
        href="https://github.com/rkanevsky/Tomoro/releases/download/v1.0.0/Tomoro-1.0.0-macos.dmg"
        class="block bg-[var(--bg-card)] border border-[var(--border)] rounded-[14px] p-[28px_24px] text-center no-underline transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_8px_40px_rgba(45,42,38,0.06)] dark:hover:shadow-[0_8px_40px_rgba(0,0,0,0.15)]"
      >
        <div class="w-12 h-12 rounded-xl bg-[var(--accent-soft)] flex items-center justify-center mx-auto mb-4">
          <svg class="w-[22px] h-[22px] text-[var(--accent)]" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
        </div>
        <div class="text-[17px] font-semibold text-[var(--text)] mb-1">macOS</div>
        <div class="text-[13px] text-[var(--text-muted)] mb-5">macOS 12+ · 20 MB</div>
        <div class="inline-block bg-[var(--accent)] text-white px-7 py-3 rounded-xl text-[14px] font-semibold transition-all duration-200 shadow-[0_4px_12px_rgba(224,104,48,0.25)]">Download .dmg</div>
      </a>

      <!-- Windows Card -->
      <a
        href="https://github.com/rkanevsky/Tomoro/releases/download/v1.0.0/Tomoro-1.0.0-windows-setup.exe"
        class="block bg-[var(--bg-card)] border border-[var(--border)] rounded-[14px] p-[28px_24px] text-center no-underline transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_8px_40px_rgba(45,42,38,0.06)] dark:hover:shadow-[0_8px_40px_rgba(0,0,0,0.15)]"
      >
        <div class="w-12 h-12 rounded-xl bg-[var(--accent-soft)] flex items-center justify-center mx-auto mb-4">
          <svg class="w-[22px] h-[22px] text-[var(--accent)]" viewBox="0 0 24 24" fill="currentColor"><path d="M3 12V6.75l8-1.25V12H3zm0 .5h8v6.5l-8-1.25V12.5zm8.5-7.5L21 3.5V12h-9.5V5zm0 7.5H21v8.5l-9.5-1.5V12.5z"/></svg>
        </div>
        <div class="text-[17px] font-semibold text-[var(--text)] mb-1">Windows</div>
        <div class="text-[13px] text-[var(--text-muted)] mb-5">Windows 10+ · 12.9 MB</div>
        <div class="inline-block bg-[var(--accent)] text-white px-7 py-3 rounded-xl text-[14px] font-semibold transition-all duration-200 shadow-[0_4px_12px_rgba(224,104,48,0.25)]">Download .exe</div>
      </a>
    </div>

    <!-- Checksums -->
    <div class="text-[12px] text-[var(--text-muted)] leading-relaxed">
      <div class="font-medium mb-2 text-[var(--text-secondary)]">SHA-256 Checksums</div>
      <div class="font-mono text-[11px] break-all">
        <div class="mb-1"><span class="text-[var(--text-secondary)]">macOS:</span> 624f6953c61854a0cb381070b82f5cf6587d2e1ddbb425554949239d2747d9a9</div>
        <div><span class="text-[var(--text-secondary)]">Windows:</span> 60a8258f7640723576b0f4e98f14d18c6a86a767b59afee11b4ac1831b93da4b</div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
